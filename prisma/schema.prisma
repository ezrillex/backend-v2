generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Shops {
  id         String       @id @default(uuid(7))
  name       String
  adapter    ShopAdapters
  enabled    Boolean      @default(true)
  created_at DateTime     @default(now())
  productos  Products[]
  Sources    Sources[]
}

model Sources {
  id          String     @id @default(uuid(7))
  data        Json
  category_id String
  shop_id     String
  created_at  DateTime   @default(now())
  JobQueue    JobQueue[]
  categories  Categories @relation(fields: [category_id], references: [id])
  shop        Shops      @relation(fields: [shop_id], references: [id])
}

model JobQueue {
  id           String    @id @default(uuid(7))
  job_data     Json
  status       JobStatus @default(PENDING)
  priority     Priority
  source_id    String
  created_at   DateTime  @default(now())
  processed_at DateTime?
  source       Sources   @relation(fields: [source_id], references: [id])
}

model Categories {
  id        String     @id @default(uuid(7))
  name      String
  keywords  String?
  productos Products[]
  Sources   Sources[]
}

model Products {
  id           String     @id @default(uuid(7))
  fingerprint  String     @unique
  name         String
  url          String
  details      String
  marca        String?
  modelo       String?
  last_updated DateTime   @updatedAt
  created_at   DateTime   @default(now())
  categoria_id String
  tienda_id    String
  keywords     String?
  imagenes     Images[]
  precios      Prices[]
  categoria    Categories @relation(fields: [categoria_id], references: [id])
  tienda       Shops      @relation(fields: [tienda_id], references: [id])

  @@index([categoria_id])
  @@index([tienda_id])
}

model Images {
  id          String   @id @default(uuid(7))
  scraped_url String   @unique
  created_at  DateTime @default(now())
  producto_id String
  bucket      Int?
  producto    Products @relation(fields: [producto_id], references: [id])

  @@index([producto_id])
}

model Prices {
  id          String   @id @default(uuid(7))
  value       Int
  created_at  DateTime @default(now()) @db.Date
  producto_id String
  producto    Products @relation(fields: [producto_id], references: [id], onDelete: Cascade)

  @@index([producto_id, created_at(sort: Desc)])
}

model Logs {
  id         String   @id @default(uuid(7))
  type       String
  data       String
  created_at DateTime @default(now())
}

model Dictionary {
  id         String   @id @default(uuid(7))
  input      String   @unique
  output     String?
  created_at DateTime @default(now())
}

model SearchTelemetry {
  id                    String   @id @default(uuid(7))
  search                String
  result_count          Int
  created_at            DateTime @default(now())
  time_taken            Float?   @default(-1)
  time_taken_flexsearch Float?   @default(-1)
  time_taken_fuzzysort  Float?   @default(-1)
  time_taken_prisma     Float?   @default(-1)
}

model GetProductTelemetry {
  id            String   @id @default(uuid(7))
  requested     String
  found_results Boolean
  created_at    DateTime @default(now())
  time_taken    Float    @default(-1)
}

model GetCategoryProductsTelemetry {
  id           String   @id @default(uuid(7))
  requested    String
  time_taken   Float    @default(-1)
  created_at   DateTime @default(now())
  result_count Int
}

model TaskTelemetry {
  id         String   @id @default(uuid(7))
  task       String
  time_taken Float    @default(-1)
  created_at DateTime @default(now())
}

enum ShopAdapters {
  KPC
  ZD
}

enum JobStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAIL
}

enum Priority {
  PRODUCT
  PAGE
  NEXT_PAGE
}
