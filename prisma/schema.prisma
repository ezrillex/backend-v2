generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ShopAdapters {
  KPC
  ZD
}

model Shops {
  id         String       @id @default(uuid(7))
  name       String
  adapter    ShopAdapters
  RootUrls   RootUrls[]
  enabled    Boolean      @default(true)
  created_at DateTime     @default(now())
}

model RootUrls {
  id          String     @id @default(uuid(7))
  url         String
  // a que categoria pertenece el url? Instead of having mappings of x->y categories. Adjust it here.
  category_id String
  categories  Categories @relation(fields: [category_id], references: [id])

  shop_id    String
  shop       Shops    @relation(fields: [shop_id], references: [id])
  created_at DateTime @default(now())
}

enum JobStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAIL
}

enum Priority {
  NORMAL
  NEXT // for when processing multi page jobs, if job determines next page exists, then schedule job with this.
}

model JobQueue {
  id           String    @id @default(uuid(7))
  job_data     Json
  status       JobStatus @default(PENDING)
  priority     Priority  @default(NORMAL)
  created_at   DateTime  @default(now())
  processed_at DateTime?
}

model Categories {
  id   String @id @default(uuid(7))
  name String

  urls RootUrls[]
}

model Products {
  id           String   @id @default(uuid(7))
  fingerprint  String
  name         String
  url          String
  details      String
  marca        String? // extract using AI mvp can skip this.
  modelo       String? // extract using AI mvp can skip this.
  last_updated DateTime @updatedAt
  created_at   DateTime @default(now())
}

// could extract multiple at once. One for cash, card, installments, etc.
// then just get the latest unique prices. Watch out for showing like a discounted old price tho.
// maybe do 24 hour check for latest.
model Prices {
  id         String   @id @default(uuid(7))
  type       String
  value      Int
  created_at DateTime @default(now())
}

model Logs {
  id        String   @id @default(uuid(7))
  type      String
  data      String   @db.Text
  timestamp DateTime @default(now())
}
