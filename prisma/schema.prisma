generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// is this necessary?
enum ShopAdapters {
  KPC
  ZD
}

model Shops {
  id         String       @id @default(uuid(7))
  name       String
  adapter    ShopAdapters
  RootUrls   RootUrls[]
  productos  Products[]
  enabled    Boolean      @default(true)
  created_at DateTime     @default(now())
}

model RootUrls {
  id          String     @id @default(uuid(7))
  url         String
  // a que categoria pertenece el url? Instead of having mappings of x->y categories. Adjust it here.
  category_id String
  categories  Categories @relation(fields: [category_id], references: [id])

  shop_id    String
  shop       Shops      @relation(fields: [shop_id], references: [id])
  created_at DateTime   @default(now())
  JobQueue   JobQueue[]
}

enum JobStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAIL
}

enum Priority {
  PRODUCT
  PAGE
  NEXT_PAGE // prioritize flipping pages before doing product scrapes or other category page scrape.
}

model JobQueue {
  id       String    @id @default(uuid(7))
  job_data Json
  status   JobStatus @default(PENDING)
  priority Priority

  root_url_id String
  root_url    RootUrls @relation(fields: [root_url_id], references: [id])

  created_at   DateTime  @default(now())
  processed_at DateTime?
}

model Categories {
  id   String @id @default(uuid(7))
  name String

  urls      RootUrls[]
  productos Products[]
}

model Products {
  id          String  @id @default(uuid(7))
  fingerprint String  @unique
  name        String
  url         String
  details     String
  marca       String? // extract using AI mvp can skip this.
  modelo      String? // extract using AI mvp can skip this.

  precios  Prices[]
  imagenes Images[]

  last_updated DateTime @updatedAt
  created_at   DateTime @default(now())

  categoria    Categories @relation(fields: [categoria_id], references: [id])
  categoria_id String

  tienda    Shops  @relation(fields: [tienda_id], references: [id])
  tienda_id String

  @@index([categoria_id])
}

model Images {
  id          String   @id @default(uuid(7))
  scraped_url String   @unique
  // cdn_url     String? // url to our hosted file.
  created_at  DateTime @default(now())
  bucket      Int? // folder number, url is cdn.site.xyz/000/image_id.jpg so no need to store it front builds it.

  producto    Products @relation(fields: [producto_id], references: [id])
  producto_id String

  @@index([producto_id])
}

model Prices {
  id         String   @id @default(uuid(7))
  value      Int
  created_at DateTime @default(now())

  producto    Products @relation(fields: [producto_id], references: [id], onDelete: Cascade)
  producto_id String

  @@index([producto_id, created_at(sort: Desc)])
}

model Logs {
  id         String   @id @default(uuid(7))
  type       String
  data       String   @db.Text
  created_at DateTime @default(now())
}

model ParseDictionary {
  id     String @id @default(uuid(7))
  input  String
  output String

  created_at DateTime @default(now())
}

model SearchTelemetry {
  id           String   @id @default(uuid(7))
  search       String
  result_count Int
  time_taken   Float?
  created_at   DateTime @default(now())
}

model GetProductTelemetry {
  id            String   @id @default(uuid(7))
  requested     String
  found_results Boolean
  time_taken    Float?
  created_at    DateTime @default(now())
}

model GetCategoryProductsTelemetry {
  id           String   @id @default(uuid(7))
  requested    String
  result_count Int
  time_taken   Float?
  created_at   DateTime @default(now())
}

